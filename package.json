{
  "name": "bioflow-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/start-demo.mjs",
    "dev:poll": "WATCHPACK_POLLING=true node scripts/start-demo.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "preview": "npm run build && next start --hostname 127.0.0.1 --port 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"{app,components,lib,scripts}/**/*.{ts,tsx,mjs,css}\" \"*.{json,mjs}\"",
    "format:check": "prettier --check \"{app,components,lib,scripts}/**/*.{ts,tsx,mjs,css}\" \"*.{json,mjs}\"",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.12",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "prettier": "^3.3.3",
    "typescript": "5.5.4"
  }
}
