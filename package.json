{
  "name": "bioflow-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "services": "node scripts/start-services.mjs",
    "test:parsers": ".venv/bin/python -m unittest discover -s services/tests -p 'test_*.py' -v",
    "test:integration": ".venv/bin/python -u -m services.tests.integration",
    "dev": "node scripts/start-demo.mjs",
    "dev:poll": "WATCHPACK_POLLING=true node scripts/start-demo.mjs",
    "build": "NEXT_DIST_DIR=.next-verification next build",
    "start": "NEXT_DIST_DIR=.next-verification next start --hostname 127.0.0.1 --port 3000",
    "preview": "npm run build && NEXT_DIST_DIR=.next-verification next start --hostname 127.0.0.1 --port 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run format:check && npm run build",
    "format": "prettier --write \"{app,components,lib,scripts}/**/*.{ts,tsx,mjs,css}\" \"*.{json,mjs}\"",
    "format:check": "prettier --check \"{app,components,lib,scripts}/**/*.{ts,tsx,mjs,css}\" \"*.{json,mjs}\"",
    "smoke": "npm run test:integration",
    "smoke:legacy": "node scripts/smoke-test.mjs",
    "cleanup:test-data": ".venv/bin/python scripts/cleanup_test_documents.py"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.12",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "prettier": "^3.3.3",
    "typescript": "5.5.4"
  }
}
