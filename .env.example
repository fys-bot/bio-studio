BIOFLOW_SESSION_SECRET=replace-with-a-long-random-secret
# Optional demo account overrides. Runtime persistence stores only scrypt hashes.
# BIOFLOW_DEMO_USER=researcher
# BIOFLOW_DEMO_PASSWORD=bioflow2026
# BIOFLOW_REVIEWER_USER=reviewer
# BIOFLOW_REVIEWER_PASSWORD=review2026
# BIOFLOW_ADMIN_USER=admin
# BIOFLOW_ADMIN_PASSWORD=admin2026
LLM_BASE_URL=https://quickaicode.com/v1
LLM_MODEL=gpt-5.5
LLM_API_KEY=replace-with-your-server-side-api-key
BIOFLOW_WORKER_URL=http://127.0.0.1:8000
BIOFLOW_WORKER_TOKEN=local-development-only
# Optional: change the local Research Service port or Qdrant storage path.
# BIOFLOW_RESEARCH_PORT=8000
# BIOFLOW_DATA_DIR=data/runtime
# BIOFLOW_QDRANT_PATH=data/runtime/qdrant
# BIOFLOW_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# BIOFLOW_MODEL_CACHE=data/runtime/models
# Optional: switch from Qdrant Local Mode to a running Qdrant server.
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=
# Optional cross-encoder. Without it the UI reports BM25 + cosine + RRF.
# BIOFLOW_RERANK_MODEL=
# Optional local Ollama vision model for scanned pages and images.
# BIOFLOW_OCR_URL=http://127.0.0.1:11434
# BIOFLOW_OCR_MODEL=qwen2.5vl:7b
